{
  "name": "dotfiles-pi-distribution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "update:pi": "pnpm update --latest --no-save @earendil-works/pi-ai @earendil-works/pi-coding-agent @earendil-works/pi-tui"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "acorn": "8.17.0",
    "linkedom": "0.18.12",
    "turndown": "7.2.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@earendil-works/pi-tui": "latest",
    "@types/node": "22.19.19",
    "@types/turndown": "5.0.5",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
