#!/bin/bash
# 紧凑三段顶栏：左侧导航、中间媒体、右侧系统状态与时钟。
# sketchybar --reload；依赖 sketchybar、yabai、jq 和 plugins/ 中的采集命令。

PLUGIN_DIR="$CONFIG_DIR/plugins"

MANTLE=0xff181825
TEXT=0xffcdd6f4
OVERLAY=0xff7f849c
BLUE=0xff89b4fa
TEAL=0xff94e2d5
MAUVE=0xffcba6f7
GREEN=0xffa6e3a1
PEACH=0xfffab387
PINK=0xfff5c2e7

sketchybar --bar \
  position=top \
  height=24 \
  y_offset=0 \
  margin=0 \
  corner_radius=0 \
  color=0xcc1e1e2e \
  blur_radius=24 \
  border_width=0 \
  padding_left=6 \
  padding_right=6 \
  topmost=window \
  sticky=on

default=(
  icon.font="Hack Nerd Font:Regular:11.0"
  label.font="Hack Nerd Font:Regular:10.0"
  icon.color="$TEXT"
  label.color="$TEXT"
  icon.padding_left=5
  icon.padding_right=3
  label.padding_left=2
  label.padding_right=5
  padding_left=0
  padding_right=0
  background.drawing=off
  background.height=20
  background.corner_radius=3
  background.border_width=0
  scroll_texts=off
  popup.background.color="$MANTLE"
  popup.background.corner_radius=6
  popup.background.border_width=1
  popup.background.border_color=0x337f849c
  popup.blur_radius=16
  popup.height=24
)
sketchybar --default "${default[@]}"

popup_row=(
  icon.drawing=off
  label.padding_left=10
  label.padding_right=10
  label.align=left
  background.drawing=off
)

# 左侧导航：只显示真实存在的工作区，活动数字下方显示短线。
for sid in {1..10}; do
  sketchybar --add space "space.$sid" left \
             --set "space.$sid" \
               space="$sid" \
               icon="$sid" icon.color="$OVERLAY" \
               icon.width=18 icon.align=center \
               icon.padding_left=0 icon.padding_right=0 \
               label.drawing=off \
               background.color="$MAUVE" \
               background.height=2 background.corner_radius=1 \
               background.y_offset=-8 \
               background.padding_left=5 background.padding_right=5 \
               script="$PLUGIN_DIR/space.sh" \
               click_script="yabai -m space --focus $sid"
done

sketchybar --add item navigation.separator left \
           --set navigation.separator \
             icon="│" icon.color=0x337f849c \
             icon.padding_left=5 icon.padding_right=5 \
             label.drawing=off

sketchybar --add item window_title left \
           --set window_title \
             icon.drawing=off \
             label.max_chars=36 \
             update_freq=2 \
             script="$PLUGIN_DIR/window.sh" \
           --subscribe window_title front_app_switched space_change

# 中区独立居中；没有正在播放或暂停的曲目时不占位置。
sketchybar --add item media center \
           --set media \
             icon="󰎈" icon.color="$PINK" \
             label.max_chars=32 drawing=off \
             update_freq=3 \
             script="$PLUGIN_DIR/media.sh"

# right 项按从右向左的顺序添加；时钟固定在最右端。
sketchybar --add item clock right \
           --set clock \
             icon.drawing=off \
             label.font="Hack Nerd Font:Bold:11.0" \
             label.padding_left=8 \
             popup.align=right \
             update_freq=1 \
             script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock mouse.entered mouse.exited mouse.exited.global

for field in date weekday; do
  sketchybar --add item "clock.details.$field" popup.clock \
             --set "clock.details.$field" "${popup_row[@]}" \
               label.width=150 label.align=center
done
sketchybar --set clock.details.weekday label.color="$BLUE"

sketchybar --add item battery right \
           --set battery \
             icon.color="$GREEN" \
             update_freq=10 \
             script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# 网络与音量作为紧凑入口；网络名称和地址留在悬停详情中。
sketchybar --add item volume right \
           --set volume \
             icon.color="$PEACH" \
             script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

sketchybar --add item network right \
           --set network \
             icon="󰖩" icon.color="$BLUE" \
             icon.padding_right=5 label.drawing=off \
             update_freq=10 \
             script="$PLUGIN_DIR/network.sh" \
           --subscribe network mouse.entered mouse.exited mouse.exited.global

for field in title interface ip gateway dns; do
  sketchybar --add item "network.details.$field" popup.network \
             --set "network.details.$field" "${popup_row[@]}" \
               label.width=240 label.max_chars=40
done
sketchybar --set network.details.title label.color="$BLUE"

# AI 区只显示 Codex；完整限额窗口保留在 popup。
sketchybar --add item ai.codex right \
           --set ai.codex \
             icon="" \
             icon.background.drawing=on \
             icon.background.image="$CONFIG_DIR/icons/codex.png" \
             icon.background.image.scale=0.375 \
             label="--" label.max_chars=24 \
             padding_left=5 padding_right=5 \
             update_freq=60 \
             script="$PLUGIN_DIR/ai_limits/run.sh" \
           --subscribe ai.codex mouse.entered mouse.exited mouse.exited.global

for field in title 1 2 3 4; do
  sketchybar --add item "ai.codex.details.$field" popup.ai.codex \
             --set "ai.codex.details.$field" "${popup_row[@]}" \
               label.width=400 label.max_chars=64
done
sketchybar --set ai.codex.details.title label.color="$MAUVE"

# CPU、内存和网速形成连续状态组；固定速率宽度避免刷新时左右跳动。
sketchybar --add item net_down right \
           --set net_down \
             icon="󰁅" icon.color="$TEAL" \
             label.width=66 label.align=right \
             update_freq=1 \
             script="$PLUGIN_DIR/netspeed.sh down"

sketchybar --add item net_up right \
           --set net_up \
             icon="󰕒" icon.color="$BLUE" \
             label.width=66 label.align=right \
             update_freq=1 \
             script="$PLUGIN_DIR/netspeed.sh up"

sketchybar --add item memory right \
           --set memory \
             icon="" icon.color="$TEAL" \
             update_freq=3 \
             script="$PLUGIN_DIR/memory.sh" \
           --subscribe memory mouse.entered mouse.exited mouse.exited.global

for field in title used cached compressed swap; do
  sketchybar --add item "memory.details.$field" popup.memory \
             --set "memory.details.$field" "${popup_row[@]}" \
               label.width=200
done
sketchybar --set memory.details.title label.color="$TEAL"

sketchybar --add item cpu right \
           --set cpu \
             icon="" icon.color="$BLUE" \
             update_freq=2 \
             script="$PLUGIN_DIR/cpu.sh"

sketchybar --update
