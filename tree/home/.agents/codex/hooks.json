{
  "description": "Global Codex guardrails backed by the shared agent-hook engine.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.local/bin/agent-hook codex-pretool",
            "timeout": 5,
            "statusMessage": "Checking command policy"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
