#!/usr/bin/env bash
# Agent 专用 rm 垫片（置于 ~/.pi/agent/bin 等 agent PATH 首位）：
# - 非递归删除，或目标全部位于 /tmp 下：透传 /bin/rm
# - 递归删除（-r/-R/--recursive）且含 /tmp 外路径：转入系统回收站，并兼容 -f 忽略不存在路径
set -euo pipefail

recursive=0
force=0
end_of_opts=0
paths=()

for arg in "$@"; do
  if (( ! end_of_opts )); then
    case "$arg" in
      --)
        end_of_opts=1
        continue
        ;;
      --recursive)
        recursive=1
        continue
        ;;
      --force)
        force=1
        continue
        ;;
      --help|--version)
        exec /bin/rm "$@"
        ;;
      --*)
        continue
        ;;
      -?*)
        flags="${arg#-}"
        [[ "$flags" == *[rR]* ]] && recursive=1
        [[ "$flags" == *f* ]] && force=1
        continue
        ;;
    esac
  fi
  paths+=("$arg")
done

if (( ! recursive || ${#paths[@]} == 0 )); then
  exec /bin/rm "$@"
fi

normalize_path() {
  local path="$1"
  [[ "$path" == /* ]] || path="$PWD/$path"
  local IFS=/
  local -a parts=() out=()
  read -ra parts <<< "$path"
  local part
  for part in "${parts[@]}"; do
    [[ -z "$part" || "$part" == "." ]] && continue
    if [[ "$part" == ".." ]]; then
      if (( ${#out[@]} > 0 )); then
        unset "out[$(( ${#out[@]} - 1 ))]"
        out=("${out[@]}")
      fi
    else
      out+=("$part")
    fi
  done
  if (( ${#out[@]} == 0 )); then
    printf '/'
  else
    printf '/%s' "${out[@]}"
  fi
}

is_tmp_path() {
  local norm
  norm="$(normalize_path "$1")"
  [[ "$norm" == "/tmp" || "$norm" == /tmp/* || "$norm" == "/private/tmp" || "$norm" == /private/tmp/* ]]
}

tmp_targets=()
outside_targets=()
for path in "${paths[@]}"; do
  if is_tmp_path "$path"; then
    tmp_targets+=("$path")
  else
    outside_targets+=("$path")
  fi
done

if (( ${#outside_targets[@]} == 0 )); then
  exec /bin/rm "$@"
fi

exit_code=0
if (( ${#tmp_targets[@]} > 0 )); then
  rm_flags="-r"
  (( force )) && rm_flags="-rf"
  /bin/rm "$rm_flags" -- "${tmp_targets[@]}" || exit_code=$?
fi

trash_targets=()
for path in "${outside_targets[@]}"; do
  if [[ -e "$path" || -L "$path" ]]; then
    if [[ "$path" == -* ]]; then
      trash_targets+=("./$path")
    else
      trash_targets+=("$path")
    fi
  elif (( ! force )); then
    printf 'rm: %s: No such file or directory\n' "$path" >&2
    exit_code=1
  fi
done

if (( ${#trash_targets[@]} > 0 )); then
  if [[ -x /usr/bin/trash ]]; then
    /usr/bin/trash "${trash_targets[@]}" || exit_code=$?
  elif command -v trash-put >/dev/null 2>&1; then
    trash-put -- "${trash_targets[@]}" || exit_code=$?
  elif command -v gio >/dev/null 2>&1; then
    gio trash -- "${trash_targets[@]}" || exit_code=$?
  else
    printf 'rm (agent-shim): 未找到可用回收站命令 (/usr/bin/trash / trash-put / gio)\n' >&2
    exit 1
  fi
fi

exit "$exit_code"
