{
  "npmCommand": [
    "pnpm"
  ],
  "theme": "dark",
  "lastChangelogVersion": "0.84.4",
  "editorPaddingX": 1,
  "terminal": {
    "showTerminalProgress": false,
    "imageWidthCells": 120
  },
  "tuiMode": "fullscreen",
  "treeFilterMode": "all",
  "doubleEscapeAction": "tree",
  "defaultProjectTrust": "always",
  "hideThinkingBlock": false,
  "defaultProvider": "ft llm proxy",
  "defaultModel": "gpt-5.6-sol",
  "steeringMode": "all",
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": false,
  "quietStartup": false,
  "modelThinkingLevels": {
    "ft llm proxy/gpt-5.6-sol": "xhigh",
    "ft llm proxy/glm-5.3-auto-bulk": "max",
    "ft llm proxy/gpt-5.6-luna": "max",
    "ft llm proxy/deepseek-v4-flash-api": "max"
  },
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto",
  "showHardwareCursor": false
}
