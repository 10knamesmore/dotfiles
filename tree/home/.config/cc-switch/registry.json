{
  "$comment": "Claude Code provider/model 注册表。无 secret——${VAR} 在切换时由 shell 展开,key 一律住 ~/.zshrc。machine-local 覆盖/新增写 ~/.local/state/cc-switch/local.json(同 schema,jq 深合并,local 优先),不入库。env 值会原样进 active.json 的 env 块;注册表里出现而当前 profile 没有的变量会被渲染成 \"\"(CC 视为 unset),保证切换无残留。",
  "providers": {
    "kimi": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.kimi.com/coding/",
        "ANTHROPIC_AUTH_TOKEN": "${KIMI_CODE_API_KEY}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "k3[1m]",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "k3-256k",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "k3-256k",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "kimi-for-coding-highspeed",
        "CLAUDE_CODE_SUBAGENT_MODEL": "k3-256k",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "262144",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "262144"
      },
      "models": {
        "k3-1m": {
          "env": {
            "ANTHROPIC_MODEL": "k3[1m]",
            "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "614400",
            "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576"
          }
        }
      }
    },
    "ds": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "${DEEPSEEK_API_KEY}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro[1m]",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro[1m]",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash[1m]",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash[1m]",
        "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash[1m]",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "614400",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576"
      }
    },
    "ftai(glm)": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://llm-proxy.ftai.chat",
        "ANTHROPIC_AUTH_TOKEN": "${FTAI_API_KEY}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "glm-5.3-auto[1m]",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.3-auto[1m]",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.3-auto[1m]",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-5.3-auto[1m]",
        "CLAUDE_CODE_SUBAGENT_MODEL": "glm-5.3-auto[1m]",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "500000"
      }
    },
    "ftai(ds)": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://llm-proxy.ftai.chat",
        "ANTHROPIC_AUTH_TOKEN": "${FTAI_API_KEY}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro[1m]",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro[1m]",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash[1m]",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash[1m]",
        "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash[1m]",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "614400",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576"
      }
    },
    "opencode": {
      "env": {
        "ANTHROPIC_BASE_URL": "https://opencode.ai/zen/go",
        "ANTHROPIC_API_KEY": "${OPENCODE_API_KEY}",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek-v4-pro[1m]",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek-v4-pro[1m]",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash[1m]",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek-v4-flash[1m]",
        "CLAUDE_CODE_SUBAGENT_MODEL": "deepseek-v4-flash[1m]",
        "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "614400",
        "CLAUDE_CODE_MAX_CONTEXT_TOKENS": "1048576"
      }
    }
  }
}
