#!/bin/sh
# 以原生 Wayland 和输入法支持启动 ChatGPT，沿用桌面 SDR 亮度，避免 HDR 屏上窗口偏暗。
# Usage: chatgpt [参数或 URL...]；参数原样转发。
# 依赖：/usr/bin/chatgpt；不额外读写环境变量。
# 禁用 Wayland 色彩管理的代价是此应用不再输出 HDR/广色域。
exec /usr/bin/chatgpt \
    --ozone-platform=wayland \
    --enable-wayland-ime \
    --disable-features=WaylandWpColorManagerV1 \
    "$@"
